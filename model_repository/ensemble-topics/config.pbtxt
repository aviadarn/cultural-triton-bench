# Server-side ensemble: tokenized inputs → ONNX MiniLM (FP16 TensorRT) →
# cuML BERTopic. One InvokeEndpoint round-trip returns topic labels.

name: "ensemble-topics"
platform: "ensemble"
max_batch_size: 0

input [
  {
    name: "input_ids"
    data_type: TYPE_INT64
    dims: [-1, -1]
  },
  {
    name: "attention_mask"
    data_type: TYPE_INT64
    dims: [-1, -1]
  }
]

output [
  {
    name: "topic_labels"
    data_type: TYPE_INT32
    dims: [-1]
  }
]

ensemble_scheduling {
  step [
    {
      model_name: "minilm-onnx"
      model_version: -1
      input_map {
        key: "input_ids"
        value: "input_ids"
      }
      input_map {
        key: "attention_mask"
        value: "attention_mask"
      }
      output_map {
        key: "sentence_embedding"
        value: "sentence_embedding"
      }
    },
    {
      model_name: "bertopic-gpu"
      model_version: -1
      input_map {
        key: "sentence_embedding"
        value: "sentence_embedding"
      }
      output_map {
        key: "topic_labels"
        value: "topic_labels"
      }
    }
  ]
}
